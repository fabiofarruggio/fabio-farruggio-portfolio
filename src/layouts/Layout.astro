---
import '../styles/global.css';
import { href, navigation, social } from '../data/site';
interface Props { title: string; description: string; active?: string }
const { title, description, active = '' } = Astro.props;
const canonical = `https://fabiofarruggio.github.io${Astro.url.pathname}`;
const mainNavigation = navigation.slice(0, 4);
const secondaryNavigation = navigation.slice(4);
const navHref = (slug: string) => href(`${slug}/`);
---
<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Fabio Farruggio`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; script-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script src={href('theme.js')} is:inline></script>
    <title>{title} · Fabio Farruggio</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header shell">
      <a class="brand" href={href()} aria-label="Fabio Farruggio — Inicio"><span class="monogram" aria-hidden="true">ff</span><span>Fabio Farruggio<small>QA Automation · Quality Engineering</small></span></a>
      <nav class="primary-nav" aria-label="Navegación principal">
        {mainNavigation.map(([slug, label]) => <a href={navHref(slug)} aria-current={active === slug ? 'page' : undefined}>{label}</a>)}
        <details class="menu"><summary>Más <span aria-hidden="true">+</span></summary><div class="menu-panel">
          {secondaryNavigation.map(([slug, label]) => <a href={navHref(slug)} aria-current={active === slug ? 'page' : undefined}>{label}</a>)}
          <a href={social.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div></details>
        <button class="theme-toggle" type="button" role="switch" aria-checked="true" aria-label="Cambiar a modo claro" data-theme-toggle>
          <span class="theme-toggle-track" aria-hidden="true"><span class="theme-toggle-thumb"></span></span>
          <span data-theme-label>Oscuro</span>
        </button>
      </nav>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-brand" href={href()}>Fabio Farruggio<span aria-hidden="true">.</span></a><p>QA Automation · Quality Engineering<br />Frameworks que los equipos pueden sostener.</p></div>
      <nav aria-label="Mapa del sitio">{navigation.map(([slug, label]) => <a href={navHref(slug)}>{label}</a>)}<a href={social.github} target="_blank" rel="noreferrer">GitHub</a></nav>
      <p class="footer-note">Self-Service Agentic Quality Platform es el proyecto principal: un laboratorio original con datos sintéticos, siete repositorios, diez roles definidos y dos squads simulados. El portfolio distingue la evidencia local de las capacidades todavía pendientes.</p>
    </footer>
  </body>
</html>
