---
import '../styles/global.css';
import { href, navigation } from '../data/site';
interface Props { title: string; description: string; active?: string }
const { title, description, active = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; script-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <title>{title} · Fabio Farruggio</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header shell">
      <a class="brand" href={href()} aria-label="Fabio Farruggio — Inicio"><span class="monogram" aria-hidden="true">ff.</span><span>Fabio Farruggio<small>Quality Engineering</small></span></a>
      <nav class="primary-nav" aria-label="Navegación principal">
        <a href={href('caso/')} aria-current={active === 'caso' ? 'page' : undefined}>El caso</a>
        <a href={href('arquitectura/')} aria-current={active === 'arquitectura' ? 'page' : undefined}>Arquitectura</a>
        <a href={href('resultados/')} aria-current={active === 'resultados' ? 'page' : undefined}>Evidencia <span aria-hidden="true">↗</span></a>
        <details class="menu"><summary>Explorar <span aria-hidden="true">+</span></summary><div class="menu-panel">{navigation.map(([slug, label]) => <a href={href(`${slug}/`)} aria-current={active === slug ? 'page' : undefined}>{label}</a>)}</div></details>
      </nav>
    </header>
    <div class="mode-bar"><div class="shell mode-content"><span><span class="status-dot" aria-hidden="true"></span> Demo individual · squads simulados</span><span><strong>offline_replay</strong> <span class="mode-note">/ publicación pendiente</span></span></div></div>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-brand" href={href()}>Fabio Farruggio<span aria-hidden="true">.</span></a><p>Decisiones claras. Evidencia trazable.<br />Sin promesas por encima de los resultados.</p></div>
      <nav aria-label="Mapa del sitio">{navigation.map(([slug, label]) => <a href={href(`${slug}/`)}>{label}</a>)}</nav>
      <p class="footer-note">Proyecto original individual. Catálogo y Pedidos son squads simulados. Sitio estático local, sin llamadas a modelos ni a servicios del laboratorio. M6 y publicación no aceptados.</p>
    </footer>
  </body>
</html>
