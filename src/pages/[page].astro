---
import Layout from '../layouts/Layout.astro';
import Architecture from '../components/Architecture.astro';
import EvidenceCards from '../components/EvidenceCards.astro';
import { career, featuredProjects, pages, agents, repositories, href } from '../data/site';
import type { Page } from '../data/site';
export function getStaticPaths() { return pages.map(page => ({ params: { page: page.slug }, props: { page } })); }
interface Props { page: Page }
const { page } = Astro.props;
const projectPages = ['proyectos', 'qa-agent'];
---
<Layout title={page.title} description={page.intro} active={page.slug}>
  <section class="page-header shell"><a class="back-link" href={href()}>← Volver al inicio</a><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="page-intro">{page.intro}</p></section>
  <div class="shell page-content">
    {projectPages.includes(page.slug) && <div class="subpage-projects">{(page.slug === 'qa-agent' ? featuredProjects.slice(0, 1) : featuredProjects).map(project => <article class={`subpage-project ${project.slug === 'qa-agent' ? 'subpage-project-featured' : ''}`}><div><span class="project-eyebrow">{project.eyebrow}</span><h2>{project.name}</h2><p>{project.description}</p></div><div class="subpage-project-meta"><span>{project.role}</span><span>{project.stack}</span><a class="text-link" href={project.url} target="_blank" rel="noreferrer">Abrir repositorio <span aria-hidden="true">↗</span></a></div></article>)}</div>}
    {page.slug === 'arquitectura' && <div class="wide-diagram"><Architecture /></div>}
    {page.slug === 'resultados' && <EvidenceCards />}
    {page.slug === 'trayectoria' && <div class="career-list career-list-page">{career.map(item => <a class="career-item" href={item.link} target="_blank" rel="noreferrer"><span>{item.period}</span><div><strong>{item.title}</strong><small>{item.detail}</small></div><span class="career-arrow" aria-hidden="true">↗</span></a>)}</div>}
    <div class="article-grid">{page.sections.map((section, index) => <section class="article-section"><span class="section-number">{String(index+1).padStart(2, '0')}</span><div><h2>{section.title}</h2><p>{section.text}</p>{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</div></section>)}</div>
    {page.slug === 'agentes' && <section class="role-list" aria-label="Roles y límites de los diez agentes">{agents.map(([id, role, limit], index) => <article><span>{String(index+1).padStart(2,'0')}</span><div><h2>{role}</h2><code>{id}</code></div><p>{limit}</p></article>)}</section>}
    {page.slug === 'repositorios' && <div class="repo-grid">{repositories.map(([name, purpose, status, url], index) => <article><span class="eyebrow">REPOSITORIO {String(index+1).padStart(2,'0')}</span><h2>{name}</h2><p>{purpose}</p><div class="repo-status">{status}</div><a class="repo-link" href={url} target="_blank" rel="noreferrer">Abrir repositorio <span aria-hidden="true">↗</span></a></article>)}</div>}
    {page.slug === 'resultados' && <aside class="note"><h2>Comprobar el origen</h2><p>Cada registro conserva repositorio, revisión, modo, límites y SHA-256 del origen. El snapshot no se presenta como estado en vivo.</p><p>Estos extractos no sustituyen una atestación del entorno ni la aceptación completa del proyecto.</p></aside>}
    <aside class="next-step"><span class="eyebrow">SEGUIR EXPLORANDO</span><a href={page.slug === 'sobre' ? href('proyectos/') : href('sobre/')}>{page.slug === 'sobre' ? 'Ver los proyectos' : 'Conocer a Fabio'} <span aria-hidden="true">↗</span></a></aside>
  </div>
</Layout>
