---
import Layout from '../layouts/Layout.astro';
import Architecture from '../components/Architecture.astro';
import EvidenceCards from '../components/EvidenceCards.astro';
import { agentGroups, agents, careerJourney, featuredProjects, pages, platformComponents, platformFlow, repositories, href } from '../data/site';
import type { Page } from '../data/site';
export function getStaticPaths() { return pages.map(page => ({ params: { page: page.slug }, props: { page } })); }
interface Props { page: Page }
const { page } = Astro.props;
const projectPages = ['proyectos', 'qa-agent'];
---
<Layout title={page.title} description={page.intro} active={page.slug}>
  <section class="page-header shell"><a class="back-link" href={href()}>← Volver al inicio</a><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="page-intro">{page.intro}</p></section>
  <div class="shell page-content">
    {projectPages.includes(page.slug) && <div class="subpage-projects">{(page.slug === 'qa-agent' ? featuredProjects.slice(0, 1) : featuredProjects).map(project => <article class={`subpage-project ${project.slug === 'qa-agent' ? 'subpage-project-featured' : ''}`}><div><span class="project-kind">{project.kind}</span><h2>{project.name}</h2><p>{project.description}</p></div><div class="subpage-project-meta"><span><strong>Rol</strong>{project.role}</span><span><strong>Tecnologías</strong>{project.stack}</span><span><strong>Alcance</strong>{project.scope}</span><a class="text-link" href={project.url} target="_blank" rel="noreferrer">Abrir código público <span aria-hidden="true">↗</span></a></div></article>)}</div>}

    {page.slug === 'qa-agent' && <section class="platform-detail" aria-labelledby="platform-detail-title">
      <div class="detail-callout"><p class="eyebrow">Cómo funciona</p><h2 id="platform-detail-title">Una necesidad entra; una decisión revisable sale.</h2><p>Los componentes se conectan con contratos y políticas. La automatización puede acelerar el trabajo, pero no obtiene autoridad implícita.</p></div>
      <ol class="platform-flow platform-flow-detail" aria-label="Flujo de trabajo de la plataforma">{platformFlow.map(step => <li><span>{step.number}</span><div><strong>{step.title}</strong><p>{step.text}</p></div></li>)}</ol>
      <h2 class="subsection-title">Componentes y responsabilidad diaria</h2>
      <div class="component-grid">{platformComponents.map(component => <article class="component-card" id={`component-${component.number}`}><div class="component-card-top"><span>{component.number}</span><a href={component.url} target="_blank" rel="noreferrer">{component.repository} <span aria-hidden="true">↗</span></a></div><h3>{component.name}</h3><p>{component.purpose}</p><dl><div><dt>Se conecta con</dt><dd>{component.connection}</dd></div><div><dt>Resultado esperado</dt><dd>{component.result}</dd></div><div><dt>Ayuda diaria</dt><dd>{component.daily}</dd></div></dl></article>)}</div>
      <div class="agent-groups"><div><p class="eyebrow">Diez roles definidos</p><h2>Responsabilidades agrupadas por etapa.</h2><p>Estos roles forman parte del diseño y del catálogo de responsabilidades. La evidencia actual es local y determinista; no demuestra diez agentes de razonamiento conectados.</p></div><div class="agent-group-grid">{agentGroups.map(group => <article><h3>{group.title}</h3><p>{group.text}</p><ul>{group.roles.map(role => <li>{role}</li>)}</ul></article>)}</div></div>
      <p class="scope-note"><strong>Límite del proyecto:</strong> `offline_replay`, costo de inferencia USD 0, sin dispatch conectado ni publicación automática. La aceptación de integración completa sigue pendiente.</p>
    </section>}

    {page.slug === 'arquitectura' && <div class="wide-diagram"><Architecture /></div>}

    {page.slug === 'trayectoria' && <section class="journey-detail" aria-labelledby="journey-title"><div><p class="eyebrow">Evolución profesional</p><h2 id="journey-title">De la ejecución al diseño de sistemas.</h2><p>La secuencia muestra cómo fue cambiando mi responsabilidad: primero entender el producto, después automatizarlo y finalmente ayudar a otros equipos a construir su propio sistema de calidad.</p></div><ol class="career-journey">{careerJourney.map(stage => <li class="career-stage"><span class="career-stage-number">{stage.number}</span><div><h3>{stage.title}</h3><p>{stage.text}</p><span class="career-tools">{stage.tools}</span></div></li>)}</ol></section>}

    <div class="article-grid">{page.sections.map((section, index) => <section class="article-section"><span class="section-number">{String(index + 1).padStart(2, '0')}</span><div><h2>{section.title}</h2><p>{section.text}</p>{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</div></section>)}</div>

    {page.slug === 'agentes' && <section class="role-list" aria-label="Roles y límites de los diez agentes">{agents.map(([id, role, limit], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{role}</h2><code>{id}</code></div><p>{limit}</p></article>)}</section>}
    {page.slug === 'repositorios' && <div class="repo-grid">{repositories.map(([name, purpose, status, url], index) => <article><span class="eyebrow">REPOSITORIO {String(index + 1).padStart(2, '0')}</span><h2>{name}</h2><p>{purpose}</p><div class="repo-status">{status}</div><a class="repo-link" href={url} target="_blank" rel="noreferrer">Abrir repositorio <span aria-hidden="true">↗</span></a></article>)}</div>}
    {page.slug === 'resultados' && <><EvidenceCards /><aside class="note"><h2>Leer los registros con contexto</h2><p>Cada extracto identifica repositorio, revisión, modo, límites y fecha. Los enlaces JSON son fuentes técnicas para reproducir la revisión; no son una interfaz de producto ni un indicador en vivo.</p><p>La evidencia no sustituye una atestación del entorno ni la aceptación completa del proyecto.</p></aside></>}

    <aside class="page-end"><span class="eyebrow">Siguiente lectura</span><div><a href={page.slug === 'sobre' ? href('proyectos/') : href('sobre/')}>{page.slug === 'sobre' ? 'Ver los proyectos seleccionados' : 'Conocer a Fabio'} <span aria-hidden="true">↗</span></a><a href={page.slug === 'qa-agent' ? href('trayectoria/') : href('qa-agent/')}>{page.slug === 'qa-agent' ? 'Ver la trayectoria' : 'Ver la plataforma'} <span aria-hidden="true">↗</span></a></div></aside>
  </div>
</Layout>
