    "evidence:import": "node scripts/import-evidence.mjs"
  },
  "dependencies": { "astro": "7.3.3" },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "typescript": "6.0.3"
  }
}
