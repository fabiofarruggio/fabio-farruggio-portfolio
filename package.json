  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node --test tests/content.test.mjs",
